<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.edu.sistemaescala</groupId>
    <artifactId>sistema-escala</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.2</javafx.version>
        <h2.version>2.4.240</h2.version>
        <bcrypt.version>0.10.2</bcrypt.version>
        <openpdf.version>2.4.0</openpdf.version>
        <pdfbox.version>3.0.3</pdfbox.version>
    </properties>

    <dependencies>
        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Banco de dados H2 (modo compatibilidade PostgreSQL) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
        </dependency>

        <!-- BCrypt para hash de senha.
             Usamos at.favre.lib no lugar de org.mindrot:jbcrypt, que esta sem
             manutencao desde 2010. Mesmo algoritmo, biblioteca mantida. -->
        <dependency>
            <groupId>at.favre.lib</groupId>
            <artifactId>bcrypt</artifactId>
            <version>${bcrypt.version}</version>
        </dependency>

        <!-- OpenPDF: geracao dos relatorios em PDF.
             Escolhido no lugar do iText moderno por causa da licenca (LGPL/MPL,
             sem a clausula viral do AGPL).

             E o artefato openpdf-core-modern (pacote org.openpdf), nao o
             openpdf: este ultimo e a linha "legacy" com.lowagie, cujas classes
             ja estao todas marcadas @Deprecated. Os dois sao a mesma
             biblioteca na mesma versao, so muda o nome do pacote.

             A linha 2.x declara todas as dependencias dela como optional,
             entao nao entra nenhum jar transitivo e nada exige rede. A 3.x
             arrasta brotli4j com binario nativo por plataforma, o que
             quebraria o empacotamento offline. -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf-core-modern</artifactId>
            <version>${openpdf.version}</version>
        </dependency>

        <!-- Apache PDFBox: usado APENAS para rasterizar (PDFRenderer) o PDF que o
             OpenPDF gera, alimentando a pre-visualizacao da tela de exportacao
             (issue #43/#52). O OpenPDF so escreve PDF, nao le nem renderiza.

             Nao substitui o OpenPDF na geracao — a decisao de
             docs/decisao-openpdf-ao-inves-de-pdfbox.md continua valendo para
             tudo o que grava PDF. Aqui o papel e o oposto: ler o PDF pronto.

             A linha 3.x base nao traz binario nativo (as deps transitivas —
             fontbox, pdfbox-io, commons-logging — sao Java puro), entao o
             empacotamento offline continua intacto. O modulo opcional que
             arrasta brotli/JAI nao entra: so pdfbox e o que ele exige. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <!-- Necessário pro Test Runner do VS Code (usa o launcher diretamente) -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <debug>false</debug>
                </configuration>
            </plugin>
            <!--
              Testes rodam com user.home apontando para dentro de target/.

              ConexaoBanco e LogAplicacao montam seus caminhos a partir de
              System.getProperty("user.home"), entao redirecionar a propriedade
              aqui faz os testes criarem um banco (e logs) proprios e
              descartaveis, sem tocar no ~/.sistema-escala do desenvolvedor.
              Antes disso todo `mvn verify` sujava o banco real com as fixtures
              dos testes de integracao.

              Nao e preciso criar target/test-home antes: o ConexaoBanco chama
              Files.createDirectories, que cria a cadeia inteira de diretorios
              que faltar.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <systemPropertyVariables>
                        <user.home>${project.build.directory}/test-home</user.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Plugin para rodar a aplicação JavaFX via Maven -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>br.edu.sistemaescala.Main</mainClass>
                </configuration>
            </plugin>
            <!-- Empacotamento do JAR principal com manifesto indicando o launcher -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>br.edu.sistemaescala.AppLauncher</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Perfil de empacotamento com jpackage para Windows (Issue #58 / Backlog #49).
          Cria o pacote executável standalone (app-image) com JRE embutida (runtime enxuta).
          Não depende de ferramentas externas como WiX Toolset.
        -->
        <profile>
            <id>empacotar-windows</id>
            <build>
                <plugins>
                    <!-- 1. Copia todas as dependências JAR para target/libs -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>copiar-dependencias</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/libs</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 2. Copia o próprio JAR da aplicação para target/libs -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>copiar-jar-aplicacao</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/libs</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 3. Executa o jpackage nativo do JDK 21 para gerar app-image -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>executar-jpackage-appimage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>app-image</argument>
                                        <argument>--name</argument>
                                        <argument>Sistema de Escala</argument>
                                        <argument>--app-version</argument>
                                        <argument>1.0.0</argument>
                                        <argument>--vendor</argument>
                                        <argument>SENAC - GOTE</argument>
                                        <argument>--description</argument>
                                        <argument>Sistema de Gestão e Automação de Escalas de Plantão</argument>
                                        <argument>--copyright</argument>
                                        <argument>Copyright (c) 2026 GOTE / SENAC</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/libs</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>br.edu.sistemaescala.AppLauncher</argument>
                                        <argument>--icon</argument>
                                        <argument>${project.basedir}/src/main/resources/frontend/assets/app.ico</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/dist</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- 4. Gera hash SHA-256 para validacao de integridade (OWASP A08 / CWE-494) -->
                            <execution>
                                <id>gerar-checksum-sha256-appimage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>powershell</executable>
                                    <arguments>
                                        <argument>-NoProfile</argument>
                                        <argument>-ExecutionPolicy</argument>
                                        <argument>Bypass</argument>
                                        <argument>-File</argument>
                                        <argument>${project.basedir}/scripts/gerar_checksums.ps1</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Perfil para gerar o Instalador MSI (.msi) para Windows.
          Requer WiX Toolset v3 instalado no sistema.
        -->
        <profile>
            <id>instalador-msi</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>copiar-dependencias-msi</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/libs</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>copiar-jar-msi</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/libs</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>executar-jpackage-msi</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>msi</argument>
                                        <argument>--name</argument>
                                        <argument>Sistema de Escala</argument>
                                        <argument>--app-version</argument>
                                        <argument>1.0.0</argument>
                                        <argument>--vendor</argument>
                                        <argument>SENAC - GOTE</argument>
                                        <argument>--description</argument>
                                        <argument>Sistema de Gestão e Automação de Escalas de Plantão</argument>
                                        <argument>--copyright</argument>
                                        <argument>Copyright (c) 2026 GOTE / SENAC</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/libs</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>br.edu.sistemaescala.AppLauncher</argument>
                                        <argument>--icon</argument>
                                        <argument>${project.basedir}/src/main/resources/frontend/assets/app.ico</argument>
                                        <argument>--win-dir-chooser</argument>
                                        <argument>--win-menu</argument>
                                        <argument>--win-shortcut</argument>
                                        <argument>--win-menu-group</argument>
                                        <argument>Sistema de Escala</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/dist</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- Gera hash SHA-256 para validacao de integridade (OWASP A08 / CWE-494) -->
                            <execution>
                                <id>gerar-checksum-sha256-msi</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>powershell</executable>
                                    <arguments>
                                        <argument>-NoProfile</argument>
                                        <argument>-ExecutionPolicy</argument>
                                        <argument>Bypass</argument>
                                        <argument>-File</argument>
                                        <argument>${project.basedir}/scripts/gerar_checksums.ps1</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Perfil de seguranca: nao roda no build normal.
          O Dependency-Check baixa a base do NVD e demora varios minutos,
          entao fica fora do `mvn clean verify` do dia a dia.
          No CI, roda semanalmente pelo workflow seguranca.yml.
        -->
        <profile>
            <id>seguranca</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>13.0.0</version>
                        <configuration>
                            <!-- Falha se houver vulnerabilidade alta ou critica (CVSS >= 7) -->
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <!-- A chave vem da variavel de ambiente: passar por parametro
                                 do Maven exporia o valor no log em modo debug (CVE-2024-23686) -->
                            <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                            <formats>
                                <format>HTML</format>
                                <format>SARIF</format>
                            </formats>
                            <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                            <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
